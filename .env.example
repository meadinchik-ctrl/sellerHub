# SELLER HUB - Environment Variables Example
# Duplicate this file to .env and adjust values

# Application Environment
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=sellerhub_super_secret_production_key_change_in_prod_123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Database
# Local SQLite default for instant zero-config startup:
DATABASE_URL=sqlite+aiosqlite:///./sellerhub.db
# PostgreSQL for Docker / Production:
# DATABASE_URL=postgresql+asyncpg://sellerhub:sellerhub_secret@localhost:5432/sellerhub_db

# Redis / Celery (Optional / fallback to internal background tasks)
REDIS_URL=redis://localhost:6379/0

# Superadmin credentials (auto-created on startup in seed if missing)
ADMIN_EMAIL=admin@sellerhub.com
ADMIN_PASSWORD=admin123456

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_USERNAME=SellerHubBot
TELEGRAM_PROXY=socks5://127.0.0.1:10808

# Google OAuth
GOOGLE_CLIENT_ID=google-client-id-placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=google-client-secret-placeholder
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google

# Storage (local or s3)
STORAGE_TYPE=local
STORAGE_DIR=./uploads
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET_NAME=sellerhub-uploads
